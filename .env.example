# Copie para .env e preencha. Chave gratuita: https://www.alphavantage.co/support/#api-key
# A chave "demo" funciona apenas com o símbolo IBM.
ALPHAVANTAGE_API_KEY=demo

# Símbolos separados por vírgula. Ações da B3 usam o sufixo .SAO (ex.: PETR4.SAO)
SIMBOLOS=IBM

# completa | incremental
MODO=completa

# compact (últimos ~100 pregões, plano gratuito) | full (série inteira, plano premium)
TAMANHO=compact

TIMEOUT_S=10
DIR_DADOS=dados

# Política de novas tentativas (será usada pelo proxy)
RETRY_TENTATIVAS=3
RETRY_BACKOFF_BASE_S=1
RETRY_BACKOFF_MAX_S=30
